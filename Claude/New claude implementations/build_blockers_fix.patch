--- /dev/null	2026-10-02 23:10:33.187881189 +0000
+++ work/gradlew	2026-10-03 00:40:00.525591938 +0000
@@ -0,0 +1,37 @@
+#!/bin/sh
+#
+# Minimal Gradle wrapper launcher (POSIX sh). Runs the wrapper JAR, which downloads and
+# runs the Gradle version pinned in gradle/wrapper/gradle-wrapper.properties (9.3.1).
+# REQUIRES gradle/wrapper/gradle-wrapper.jar (see README note / regenerate with
+# `gradle wrapper --gradle-version 9.3.1`, which overwrites this script with the official one).
+
+app_path=$0
+while [ -h "$app_path" ]; do
+    ls=$( ls -ld -- "$app_path" )
+    link=${ls#*' -> '}
+    case $link in
+      /*) app_path=$link ;;
+      *) app_path=${app_path%/*}/$link ;;
+    esac
+done
+APP_HOME=$( cd -P "${app_path%/*}" > /dev/null && pwd -P ) || exit
+
+CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
+if [ ! -f "$CLASSPATH" ]; then
+    echo "ERROR: $CLASSPATH is missing." >&2
+    echo "Generate it once with a local Gradle 9.3.1+:  gradle wrapper --gradle-version 9.3.1" >&2
+    exit 1
+fi
+
+if [ -n "$JAVA_HOME" ]; then
+    JAVACMD=$JAVA_HOME/bin/java
+    [ -x "$JAVACMD" ] || { echo "ERROR: JAVA_HOME is invalid: $JAVA_HOME" >&2; exit 1; }
+else
+    JAVACMD=java
+    command -v java >/dev/null 2>&1 || { echo "ERROR: JAVA_HOME is not set and no 'java' found in PATH." >&2; exit 1; }
+fi
+
+exec "$JAVACMD" -Xmx64m -Xms64m -Dfile.encoding=UTF-8 \
+    "-Dorg.gradle.appname=gradlew" \
+    -classpath "$CLASSPATH" \
+    org.gradle.wrapper.GradleWrapperMain "$@"
--- /dev/null	2026-10-02 23:10:33.187881189 +0000
+++ work/gradlew.bat	2026-10-03 00:40:00.527946013 +0000
@@ -0,0 +1,16 @@
+@rem Minimal Gradle wrapper launcher (Windows). Requires gradle\wrapper\gradle-wrapper.jar.
+@rem Regenerate the official files with: gradle wrapper --gradle-version 9.3.1
+@echo off
+setlocal
+set DIRNAME=%~dp0
+if "%DIRNAME%"=="" set DIRNAME=.
+set APP_HOME=%DIRNAME%
+set CLASSPATH=%APP_HOME%gradle\wrapper\gradle-wrapper.jar
+if not exist "%CLASSPATH%" (
+  echo ERROR: %CLASSPATH% is missing. 1>&2
+  echo Generate it once with: gradle wrapper --gradle-version 9.3.1 1>&2
+  exit /b 1
+)
+if defined JAVA_HOME (set JAVA_EXE=%JAVA_HOME%\bin\java.exe) else (set JAVA_EXE=java.exe)
+"%JAVA_EXE%" -Xmx64m -Xms64m -Dfile.encoding=UTF-8 "-Dorg.gradle.appname=gradlew" -classpath "%CLASSPATH%" org.gradle.wrapper.GradleWrapperMain %*
+endlocal
